# Copy this file to `.env` and fill in values before running `docker-compose up`.
# `.env` is gitignored; `.env.example` is checked in as the canonical list of
# variables the stack expects.

# MariaDB (cache_db)
MYSQL_ROOT_PASSWORD=

# MongoDB (cloudhub_mongo)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=

# Neo4j (aegis_neo4j) — community edition requires password >= 8 chars
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Aegis / backend shared secrets
ENCRYPTION_KEY=
INTERNAL_SERVICE_KEY=

# LLM provider credentials (used by testgenerator)
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
