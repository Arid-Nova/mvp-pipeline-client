# .env

# ================================
# Database Credentials
# ================================
MYSQL_URL=local_mysql_connection_string
MYSQL_ROOT_USERNAME=local_mysql_root_username
MYSQL_ROOT_PASSWORD=local_mysql_root_password

MONGO_ROOT_USERNAME=local_mongo_root_username
MONGO_ROOT_PASSWORD=local_mongo_root_password
MONGO_AUTH_SOURCE=local_mongo_auth_source
MONGO_URI=mongo_connection_string

NEO4J_URI=bolt__connection_string
NEO4J_USERNAME=local_neo4j_username
NEO4J_PASSWORD=local_neo4j_password

# ================================
# Security & Internal Auth
# ================================
ENCRYPTION_KEY=local_encryption_key_32_chars_min
INTERNAL_SERVICE_KEY=local_internal_service_key

# ================================
# User Service: landing page forms
# ================================
# Comma-separated origins allowed to call the user service from a browser
# (localhost:3000 is always allowed). Compose defaults to the aridnova.net origins.
LANDING_ORIGINS=https://aridnova.net,https://www.aridnova.net
# Azure Communication Services Email for contact-request notifications.
# Leave empty locally: leads are still stored, with email_status "not_configured".
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=DoNotReply@your-domain.azurecomm.net
# Comma-separated recipients of contact-request notifications.
CONTACT_NOTIFY_TO=team@example.com

# ================================
# OpenAI / LLM Configuration
# ================================
LLM_TEMPERATURE=0.3
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ================================
# Housekeeping / Cleanup Configuration
# ================================
IR_RETENTION_DAYS=1
ARIDNOVA_API_URL=http://localhost:8123