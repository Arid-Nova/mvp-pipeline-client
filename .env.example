# Copy this file to `.env` and fill in values before running `docker-compose up`.
# `.env` is gitignored; `.env.example` is checked in as the canonical list of
# variables the stack expects.

# MariaDB (cache_db)
MYSQL_ROOT_PASSWORD=

# MongoDB (cloudhub_mongo)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
# Optional overrides — compose builds a URI from the credentials above when unset.
MONGO_AUTH_SOURCE=admin
MONGO_URI=

# Neo4j (aegis_neo4j) — community edition requires password >= 8 chars
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Optional override — defaults to bolt://aegis_neo4j:7687 when unset.
NEO4J_URI=

# Aegis / backend shared secrets
ENCRYPTION_KEY=
INTERNAL_SERVICE_KEY=

# LLM provider credentials (used by testgenerator, scenariogenerator,
# repohandler and aegis)
OPENAI_API_KEY=
# Azure OpenAI needs the /openai/v1/ suffix — the bare resource host returns
# 404 "Resource not found" because the OpenAI SDK appends chat/completions.
# Live VM value:
#   OPENAI_BASE_URL=https://aridnova-openai.openai.azure.com/openai/v1/
OPENAI_BASE_URL=
# On Azure this is the *deployment* name you chose, not the model id. A wrong
# value returns 404 DeploymentNotFound. The live deployment is named
# "gpt-4o-mini" but is backed by gpt-5-mini, because gpt-4o-mini is deprecated
# and Azure will no longer accept it for new deployments.
OPENAI_API_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# PostHog analytics, baked into the frontend bundle at build time. The phc_ key
# is a public client-side key, not a secret.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Production deploy (docker-compose.prod.yaml) — Caddy reverse proxy.
# A domain pointing at the VM enables auto-HTTPS via Let's Encrypt.
# Multiple hostnames may be space-separated; Caddy issues a cert for each.
# Set to ":80" for HTTP-only (e.g. when demoing by raw IP).
# Live VM value:
#   DEMO_DOMAIN=aridnova-demo-mvp.eastus.cloudapp.azure.com toolkit.aridnova.net
DEMO_DOMAIN=toolkit.aridnova.net

# Browser origins the Spring services (backend, components, chatbot) accept.
# Comma-separated, no spaces. Single source of truth — docker-compose passes
# this to every service that needs it, so add a new domain here only.
# Behind the Caddy proxy the browser sees same-origin requests, but Spring
# reconstructs the request as http:// and so treats them as cross-origin; the
# public https:// origin must therefore be listed here or Spring returns
# "403 Invalid CORS request".
CORS_ALLOWED_ORIGINS=https://toolkit.aridnova.net,https://aridnova.net,https://www.aridnova.net,http://localhost:3000,http://localhost:8080
