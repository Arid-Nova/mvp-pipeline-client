# Build from the pipeline repository root: docker build -f componentanalysis/dockerfile .
FROM node:22-bookworm-slim AS node
FROM maven:3.9.9-eclipse-temurin-21 AS build
COPY --from=node /usr/local /usr/local
RUN apt-get update && apt-get install -y --no-install-recommends python3 git && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY cimet-source.lock.json ./
COPY scripts/build_cimet.py scripts/vendor_javascript_security.py ./scripts/
COPY javascript-security ./javascript-security
RUN python3 scripts/build_cimet.py
COPY componentanalysis/pom.xml ./componentanalysis/pom.xml
COPY componentanalysis/src ./componentanalysis/src
RUN mvn -B -f componentanalysis/pom.xml -DskipTests package

FROM eclipse-temurin:21-jre
COPY --from=node /usr/local /usr/local
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 aridnova && useradd --uid 10001 --gid aridnova --home-dir /app --create-home aridnova
WORKDIR /app
RUN chown 10001:10001 /app
COPY --from=build --chown=10001:10001 /workspace/componentanalysis/target/MVPComponents-0.0.1-SNAPSHOT.war /app/application.war
COPY --from=build --chown=10001:10001 /workspace/componentanalysis/vendor /app/vendor
ENV CIMET_JAVASCRIPT_ADAPTER=/app/vendor/javascript
USER 10001:10001
EXPOSE 8060
ENTRYPOINT ["java", "-jar", "/app/application.war", "--server.port=8060"]
