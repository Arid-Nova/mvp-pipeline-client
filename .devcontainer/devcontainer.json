{
  "name": "Backend Dev",
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "app",
  "workspaceFolder": "/workspaces",
  "remoteUser": "root",
  "overrideCommand": true,
  "containerEnv": {
    "GH_CONFIG_DIR": "/home/vscode/.github-auth"
  },
  "mounts": [
    "source=github-cli-auth,target=/home/vscode/.config/gh,type=volume"
  ],
  "postAttachCommand": "bash .devcontainer/script/on-attach.sh",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/git:1": {
      "ppa": false
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {
      "autoPull": true
    },
    "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {},
    "ghcr.io/stu-bell/devcontainer-features/open-code:0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}