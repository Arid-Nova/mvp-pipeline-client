# Use Node.js 18 image as the base image
FROM node:18-alpine

# Set the working directory inside the container
WORKDIR /app

# Copy the package.json and package-lock.json files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the entire React project to the working directory
COPY . .

# Setting Environment Variables
ARG REACT_APP_IR_SERVICE_URL
ARG REACT_APP_VERIFY_SERVICE_URL
ARG REACT_APP_COMPONENT_SERVICE_URL
ARG REACT_APP_VECTOR_SERVICE_URL
ARG REACT_APP_ANALYSIS_SERVICE_URL
ARG REACT_APP_TEST_SERVICE_URL
ARG REACT_APP_AEGIS_SERVICE_URL
ARG REACT_APP_REPO_SERVICE_URL
ARG REACT_APP_CHATBOT_SERVICE_URL
ARG REACT_APP_USER_SERVICE_URL
ARG REACT_APP_EXEC_SERVICE_URL
ARG REACT_APP_INTERNAL_SERVICE_KEY
ARG REACT_APP_PUBLIC_POSTHOG_KEY
ARG REACT_APP_PUBLIC_POSTHOG_HOST
ARG REACT_APP_IS_DEMO_VERSION

ENV REACT_APP_IR_SERVICE_URL=$REACT_APP_IR_SERVICE_URL
ENV REACT_APP_VERIFY_SERVICE_URL=$REACT_APP_VERIFY_SERVICE_URL
ENV REACT_APP_COMPONENT_SERVICE_URL=$REACT_APP_COMPONENT_SERVICE_URL
ENV REACT_APP_VECTOR_SERVICE_URL=$REACT_APP_VECTOR_SERVICE_URL
ENV REACT_APP_ANALYSIS_SERVICE_URL=$REACT_APP_ANALYSIS_SERVICE_URL
ENV REACT_APP_TEST_SERVICE_URL=$REACT_APP_TEST_SERVICE_URL
ENV REACT_APP_AEGIS_SERVICE_URL=$REACT_APP_AEGIS_SERVICE_URL
ENV REACT_APP_REPO_SERVICE_URL=$REACT_APP_REPO_SERVICE_URL
ENV REACT_APP_CHATBOT_SERVICE_URL=$REACT_APP_CHATBOT_SERVICE_URL
ENV REACT_APP_USER_SERVICE_URL=$REACT_APP_USER_SERVICE_URL
ENV REACT_APP_EXEC_SERVICE_URL=$REACT_APP_EXEC_SERVICE_URL
ENV REACT_APP_INTERNAL_SERVICE_KEY=$REACT_APP_INTERNAL_SERVICE_KEY
ENV REACT_APP_PUBLIC_POSTHOG_KEY=$REACT_APP_PUBLIC_POSTHOG_KEY
ENV REACT_APP_PUBLIC_POSTHOG_HOST=$REACT_APP_PUBLIC_POSTHOG_HOST
ENV REACT_APP_IS_DEMO_VERSION=$REACT_APP_IS_DEMO_VERSION

# Build the React application
RUN npm run build

# Install http-server to serve the static files
RUN npm install -g http-server

# Expose the port the app will run on
EXPOSE 3000

# Serve the build folder using http-server
CMD ["http-server", "build", "-p", "3000"]
