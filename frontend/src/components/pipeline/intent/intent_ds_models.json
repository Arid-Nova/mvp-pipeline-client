{
  "documentType": "aridnova-intent-ds-models",
  "modelId": "aridnova.intent.inference.ds",
  "version": "1.0.0",
  "status": "active-for-suggestion-ranking",
  "purpose": "Infer one or more likely analysis intents from the cards, directed connections, and configuration in an Aridnova canvas.",
  "modelingNotes": {
    "intentMultiplicity": "Intents are modeled independently as binary present/absent hypotheses so a canvas can express multiple simultaneous goals.",
    "beliefMeaning": "A focal set containing both present and absent represents unresolved evidence, not simultaneous presence and absence.",
    "openWorld": true,
    "unknownIntentHandling": "Keep uncommitted mass on the full binary frame when the canvas is incomplete, ambiguous, or does not match known patterns. Do not force a known intent.",
    "massStatus": "Mass profiles are configured for deterministic suggestion ordering.",
    "decisionUse": "Only the ordering of deterministic question suggestions is exposed; numeric scores are not shown."
  },
  "inputGraphContract": {
    "connectionsAreDirected": true,
    "repeatableCardTypes": true,
    "validConnections": {
      "SYSTEM_INPUT": [
        "MULTI_REPO",
        "COMPONENT_GENERATE",
        "VISUALIZATION",
        "CHANGE_IMPACT"
      ],
      "MULTI_REPO": [
        "IR_HOLDER",
        "FORMAL_VERIFY",
        "CHANGE_IMPACT"
      ],
      "UPLOAD_IR": [
        "IR_HOLDER"
      ],
      "COMPONENT_GENERATE": [
        "COMPONENT_HOLDER"
      ],
      "COMPONENT_HOLDER": [
        "SCENARIO_GENERATE"
      ],
      "IR_HOLDER": [
        "FORMAL_VERIFY",
        "VISUALIZATION",
        "AEGIS",
        "CHANGE_IMPACT"
      ],
      "SCENARIO_GENERATE": [
        "PROMPT_GENERATE",
        "VERIFICATION_COMPARISON"
      ],
      "PROMPT_GENERATE": [
        "TEST_GENERATE"
      ],
      "TEST_GENERATE": [
        "TEST_EXECUTOR"
      ],
      "TEST_EXECUTOR": [],
      "FORMAL_VERIFY": [
        "FORMAL_VIZ",
        "SCENARIO_GENERATE",
        "VERIFICATION_COMPARISON",
        "SECURITY_REGRESSION"
      ],
      "VISUALIZATION": [],
      "AEGIS": [],
      "FORMAL_VIZ": [],
      "VERIFICATION_COMPARISON": [],
      "CHANGE_IMPACT": [
        "SCENARIO_GENERATE"
      ],
      "SECURITY_REGRESSION": [
        "FORMAL_VIZ"
      ]
    }
  },
  "beliefModel": {
    "theory": "Dempster-Shafer",
    "framePerIntent": [
      "present",
      "absent"
    ],
    "normalizedMassAssignment": true,
    "focalSetTemplate": [
      {
        "hypotheses": [
          "present"
        ],
        "mass": null
      },
      {
        "hypotheses": [
          "absent"
        ],
        "mass": null
      },
      {
        "hypotheses": [
          "present",
          "absent"
        ],
        "mass": null
      }
    ],
    "massConstraints": {
      "eachMassInRange": [
        0.0,
        1.0
      ],
      "sumPerEvidenceRule": 1.0,
      "emptySetMass": 0.0,
      "nullMeans": "uncalibrated and not executable"
    },
    "combination": {
      "rule": "dempster-normalized",
      "combineOnlyConditionallyIndependentEvidenceGroups": true,
      "conflictMeasure": "K = sum(m1(A) * m2(B)) for all disjoint focal sets A and B",
      "highConflictAction": "Return conflict and abstain or request clarification; do not hide high conflict by reporting only normalized scores.",
      "avoidDoubleCounting": "Treat a matched graph motif as one evidence item. Do not separately combine card presence, its connecting edges, and the same derived motif as if they were independent."
    },
    "decisionProjection": {
      "method": "pignistic",
      "probabilityForPresent": "BetP(present) = m({present}) + 0.5 * m({present, absent})",
      "interpretation": "Pignistic projection is used internally to order deterministic question suggestions; numeric values are not shown to users."
    }
  },
  "evidenceSources": [
    {
      "id": "graph_motif",
      "description": "A bound subgraph pattern using card types and directed edges as one evidence item."
    },
    {
      "id": "node_configuration",
      "description": "Configured repositories, branches, commits, snapshot identifiers, targets, and other card settings."
    },
    {
      "id": "canvas_state",
      "description": "Whether the canvas is a draft, saved, or explicitly marked complete."
    },
    {
      "id": "user_confirmed_intent",
      "description": "An explicit user-selected or user-confirmed intent label, when available."
    }
  ],
