# Local development secrets. This file is gitignored.
# Override any value before running `docker-compose up`.

# MariaDB
MYSQL_ROOT_PASSWORD=changeme-mariadb

# MongoDB
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=changeme-mongo

# Neo4j (community edition requires password >= 8 chars)
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme-neo4j

# Aegis / backend shared secrets
ENCRYPTION_KEY=local-dev-encryption-key-change-me
INTERNAL_SERVICE_KEY=local-dev-internal-service-key

# LLM provider credentials — fill in before running testgenerator
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
